# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Папка с данными кейса (rules.json, taxonomy.json, tickets_*.jsonl).
# Данные Grand Mobile в репозиторий не кладутся по условиям кейса.
COPILOT_DATA_DIR=data/support/handout

# Ключ Gemini API (бесплатно: https://aistudio.google.com/apikey).
# Без ключа сервис работает в офлайн-режиме: черновики из шаблонов.
GEMINI_API_KEY=

# auto — LLM, если есть ключ; offline — всегда без LLM.
COPILOT_LLM_MODE=auto
COPILOT_LLM_MODEL=gemini-3.5-flash-lite
